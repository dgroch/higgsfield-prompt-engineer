# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Higgsfield MCP — Option A (official remote)
HIGGSFIELD_MCP_URL=https://...your-account-scoped-url...
HIGGSFIELD_OAUTH_TOKEN=...

# Higgsfield MCP — Option B (community local fallback)
# HIGGSFIELD_MCP_MODE=local
# HF_API_KEY=...
# HF_SECRET=...

# Eval harness defaults (can be overridden by CLI flags)
EVAL_MAX_ITERATIONS=3
EVAL_THRESHOLD=0.8
EVAL_OUTPUT_DIR=runs

# ffmpeg binary (override if not on PATH)
# FFMPEG_BIN=/usr/local/bin/ffmpeg
